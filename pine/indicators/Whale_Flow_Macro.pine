// ════════════════════════════════════════════════════════════════════════════
//  WHALE FLOW & MACRO v2 — lower-pane companion (separate panel under candles)
//
//  WHAT IT ACTUALLY MEASURES (honest version):
//  TradingView cannot see whale wallets, order books, or exchange long/short
//  account ratios — no Pine script can. This panel uses the best proxies TV
//  data really provides, and v2 makes each one MORE PRECISE:
//
//  ① VOLUME DELTA — each chart bar is split into intrabars (auto-picked lower
//    timeframe); up-closing intrabar volume counts as aggressive buying,
//    down-closing as selling. Columns show delta as % of bar volume (−100…+100).
//  ② WHALE PRINTS — v2 definition is stricter on purpose: a bar must have
//    top-percentile VOLUME **and** ≥ dominance% one-sided delta. Huge-volume
//    bars where buys≈sells are churn, not a whale statement — v1 counted
//    them, v2 doesn't. Only true prints color bright and feed the bias line.
//  ③ ABSORPTION — new: top-percentile volume forced into a BOTTOM-percentile
//    range = someone absorbing everything thrown at them (iceberg behaviour).
//    Marked with a diamond; deliberately direction-neutral.
//  ④ WHALE vs CROWD — new: the thick line is whale-print bias, the thin one
//    is net flow of ALL volume ("the crowd"). When whales lean one way while
//    the crowd leans the other, that's the classic distribution/accumulation
//    signature — background tints and the verdict row call it out.
//  ⑤ OPEN INTEREST READ — OI↑+price↑ new longs · OI↑+price↓ new shorts ·
//    OI↓+price↑ short squeeze · OI↓+price↓ long flush. v2 adds a noise gate
//    (tiny OI wiggles no longer flip the strip every bar) and a 24h OI Δ row.
//    Uses TV's perp OI feed (<tickerid>_OI); shows n/a where unsupported.
//  ⑥ DXY LINK — rolling correlation vs the Dollar Index (context, not a rule;
//    quiet on weekends).
//
//  PRECISION RULES: with "Signals on closed bars only" ON (default), every
//  alert and the verdict evaluate the last CLOSED bar — nothing repaints.
//  The plots update live (that is what a live pane is for); the DECISIONS
//  don't. Set alerts to "Once Per Bar Close".
//
//  Defaults tuned for 15m crypto perps; the intrabar TF auto-scales with the
//  chart timeframe, so 5m/1h/4h work without touching settings.
// ════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Whale Flow & Macro", overlay=false, format=format.price, precision=1)

// ╔═══════════════════════════════════════════════════════╗
// ║  INPUTS                                                ║
// ╚═══════════════════════════════════════════════════════╝
gW = "① Whale Prints"
autoLtf   = input.bool(true, "Auto Intrabar Timeframe", group=gW, tooltip="Picks the delta-split timeframe from the chart TF (≈ chart/15, min 1m): 15m→1m, 1h→5m, 4h→15m. Turn off to set it manually below.")
ltfManual = input.timeframe("1", "Manual Intrabar TF", group=gW)
whalePct  = input.int(90, "Whale Volume Percentile", minval=70, maxval=99, group=gW, tooltip="A bar needs volume at/above this percentile of the lookback to qualify. 90 = top 10% of bars.")
domTh     = input.int(55, "Whale Dominance % (one-sided delta)", minval=0, maxval=95, group=gW, tooltip="NEW in v2: the bar's |delta| must also be at least this % of its volume. 55 = at least 55% of the traded volume hit one side. 0 = v1 behaviour (any big bar counts).")
pctLen    = input.int(200, "Percentile Lookback (bars)", minval=50, maxval=1000, group=gW, tooltip="200 bars ≈ 2 days on 15m.")
biasLen   = input.int(96, "Bias / Flow Window (bars)", minval=20, maxval=500, group=gW, tooltip="Rolling window for the whale-bias and crowd-flow lines. 96 bars = 1 day on 15m.")
biasTh    = input.int(40, "Bias Flip Threshold (±)", minval=10, maxval=90, group=gW)
useClosed = input.bool(true, "Signals on closed bars only (no repaint)", group=gW, tooltip="Alerts, verdict and background tints evaluate the last CLOSED bar. Strongly recommended.")

gA = "② Absorption"
showAbs   = input.bool(true, "Detect Absorption Bars", group=gA)
absRngPct = input.int(35, "Max Range Percentile", minval=10, maxval=60, group=gA, tooltip="Absorption = top-percentile VOLUME inside a bar whose RANGE is at/below this percentile: huge size, almost no movement — iceberg behaviour.")

gS = "③ Whale vs Crowd"
splitTh   = input.int(15, "Crowd Flow Threshold (±)", minval=5, maxval=60, group=gS, tooltip="Distribution = whale bias ≤ −(bias threshold) while crowd flow ≥ +this. Accumulation is the mirror. Rare by design — that is the point.")
showTint  = input.bool(true, "Tint Background on Split", group=gS)

gO = "④ Open Interest"
showOI     = input.bool(true, "Show OI Positioning Strip", group=gO)
oiSigTh    = input.float(0.15, "OI Significance (% per bar)", minval=0.0, maxval=2.0, step=0.05, group=gO, tooltip="NEW in v2: |ΔOI| below this % of OI counts as FLAT instead of flipping the strip on every wiggle.")
oiOverride = input.symbol("", "OI Symbol Override", group=gO, tooltip="Empty = auto <chart ticker>_OI (Binance/Bybit/OKX perps).")

gD = "⑤ DXY Link"
showDxy    = input.bool(true, "Show DXY Correlation Line", group=gD)
dxySym     = input.symbol("TVC:DXY", "Dollar Index Symbol", group=gD)
corrLen    = input.int(200, "Correlation Length (bars)", minval=30, maxval=1000, group=gD)
dxyTrendLen= input.int(50, "DXY Trend EMA", minval=10, maxval=200, group=gD)

gP = "⑥ Panel"
showTbl   = input.bool(true, "Show Summary Table", group=gP)
tblPos    = input.string("Top Right", "Position", ["Top Right","Top Left","Bottom Right","Bottom Left"], group=gP)
tblSize   = input.string(size.small, "Text Size", [size.tiny, size.small, size.normal], group=gP)

// colors (match the All-in-One palette)
BUY  = #26a69a
SELL = #ef5350
AMBR = #ffb300
TEAL = #4dd0e1
ORNG = #ff9800
PURP = #ab47bc

// ╔═══════════════════════════════════════════════════════╗
// ║  ① VOLUME DELTA (auto intrabar TF)                     ║
// ╚═══════════════════════════════════════════════════════╝
// auto lower TF ≈ chart/15, floored at 1 minute — 15m→1m, 1h→4m, 4h→16m
int chartSec = timeframe.in_seconds(timeframe.period)
string ltfAuto = timeframe.from_seconds(math.max(60, chartSec / 15))
string ltfUsed = autoLtf ? ltfAuto : ltfManual

// intrabar signed volume: up-closing intrabar = buy, down-closing = sell
f_delta() =>
    close > open ? volume : close < open ? -volume : close >= nz(close[1], close) ? volume : -volume

deltaArr = request.security_lower_tf(syminfo.tickerid, ltfUsed, f_delta())

// fallback beyond the intrabar history limit: estimate the buy share from
// where the bar closed inside its own range
float rawDelta = deltaArr.size() > 0 ? deltaArr.sum() : (high == low ? 0.0 : nz(volume) * (2 * (close - low) / (high - low) - 1))
float deltaPct = nz(volume) > 0 ? rawDelta / volume * 100 : 0.0

// ╔═══════════════════════════════════════════════════════╗
// ║  ② WHALE PRINTS + ABSORPTION                           ║
// ╚═══════════════════════════════════════════════════════╝
whaleThr = ta.percentile_nearest_rank(volume, pctLen, whalePct)
bigVol   = not na(whaleThr) and nz(volume) >= whaleThr

rng      = high - low
rngThr   = ta.percentile_nearest_rank(rng, pctLen, absRngPct)

// v2: a whale PRINT needs size AND one-sided aggression
isWhale  = bigVol and math.abs(deltaPct) >= domTh
// absorption: size with NO movement (and no side dominating)
isAbsorb = showAbs and bigVol and not na(rngThr) and rng > 0 and rng <= rngThr and math.abs(deltaPct) < domTh

// whale bias: net direction of whale PRINTS only
whaleSigned = isWhale ? rawDelta : 0.0
whaleAbs    = isWhale ? math.abs(rawDelta) : 0.0
biasNum     = math.sum(whaleSigned, biasLen)
biasDen     = math.sum(whaleAbs, biasLen)
whaleBias   = biasDen > 0 ? biasNum / biasDen * 100 : 0.0

// crowd flow: net aggression of ALL volume over the same window
flowNum   = math.sum(rawDelta, biasLen)
flowDen   = math.sum(nz(volume), biasLen)
crowdFlow = flowDen > 0 ? flowNum / flowDen * 100 : 0.0

var int lastWhaleBar = na
var int lastWhaleDir = 0
if isWhale
    lastWhaleBar := bar_index
    lastWhaleDir := rawDelta >= 0 ? 1 : -1
var int lastAbsorbBar = na
if isAbsorb
    lastAbsorbBar := bar_index

// ╔═══════════════════════════════════════════════════════╗
// ║  ③ WHALE vs CROWD SPLIT                                ║
// ╚═══════════════════════════════════════════════════════╝
// closed-bar view of every decision input (precision switch)
f_c(x) => useClosed ? x[1] : x
cBias   = f_c(whaleBias)
cFlow   = f_c(crowdFlow)
cWhale  = f_c(isWhale)
cDelta  = f_c(rawDelta)
cAbsorb = f_c(isAbsorb)

distrib = cBias <= -biasTh and cFlow >= splitTh     // whales SELL into crowd buying
accum   = cBias >= biasTh and cFlow <= -splitTh     // whales BUY into crowd selling

// ╔═══════════════════════════════════════════════════════╗
// ║  ④ OPEN INTEREST POSITIONING (noise-gated)             ║
// ╚═══════════════════════════════════════════════════════╝
oiTicker = oiOverride != "" ? oiOverride : syminfo.tickerid + "_OI"
oiClose  = request.security(oiTicker, timeframe.period, close, ignore_invalid_symbol=true)
oiOk     = not na(oiClose)
oiDelta  = oiOk ? oiClose - nz(oiClose[1], oiClose) : na
oiDeltaPct = oiOk and nz(oiClose[1]) > 0 ? oiDelta / oiClose[1] * 100 : na
priceUp  = close >= nz(close[1], close)

// bars in ~24h for the OI Δ24h row
int barsPerDay = math.max(1, math.round(86400.0 / chartSec))
float oi24hPct = oiOk and nz(oiClose[barsPerDay]) > 0 ? (oiClose / oiClose[barsPerDay] - 1) * 100 : na

// 1 longs opening · 2 shorts opening · 3 shorts closing · 4 longs closing
bool oiSig = oiOk and not na(oiDeltaPct) and math.abs(oiDeltaPct) >= oiSigTh
int oiState = not oiSig ? 0 : oiDelta > 0 ? (priceUp ? 1 : 2) : (priceUp ? 3 : 4)
color oiCol = oiState == 1 ? BUY : oiState == 2 ? SELL : oiState == 3 ? TEAL : oiState == 4 ? ORNG : color.new(color.gray, 60)
string oiTxt = oiState == 1 ? "Longs opening" : oiState == 2 ? "Shorts opening" : oiState == 3 ? "Shorts closing" : oiState == 4 ? "Longs closing" : oiOk ? "Flat" : "n/a on this chart"
cOiState = f_c(oiState)

// ╔═══════════════════════════════════════════════════════╗
// ║  ⑤ DXY LINK                                            ║
// ╚═══════════════════════════════════════════════════════╝
dxy    = request.security(dxySym, timeframe.period, close, ignore_invalid_symbol=true)
dxyOk  = not na(dxy)
corr   = dxyOk ? ta.correlation(ta.change(close), ta.change(dxy), corrLen) * 100 : na
dxyEma = ta.ema(dxy, dxyTrendLen)
dxyUp  = dxyOk and dxy > dxyEma

// ╔═══════════════════════════════════════════════════════╗
// ║  VERDICT — the one-line synthesis                      ║
// ╚═══════════════════════════════════════════════════════╝
string verdict = distrib ? "DISTRIBUTION — whales sell into crowd buying" :
     accum ? "ACCUMULATION — whales buy into crowd selling" :
     cAbsorb ? "ABSORPTION — big size, no movement" :
     cBias >= biasTh ? "Whale flow: LONG lean" :
     cBias <= -biasTh ? "Whale flow: SHORT lean" :
     "No clear whale lean"
color verdictC = distrib ? SELL : accum ? BUY : cAbsorb ? PURP :
     cBias >= biasTh ? BUY : cBias <= -biasTh ? SELL : AMBR

// ╔═══════════════════════════════════════════════════════╗
// ║  PLOTS                                                 ║
// ╚═══════════════════════════════════════════════════════╝
colDelta = isWhale ? (rawDelta >= 0 ? color.new(BUY, 0) : color.new(SELL, 0)) : (rawDelta >= 0 ? color.new(BUY, 74) : color.new(SELL, 74))
plot(deltaPct, "Delta % of Volume", style=plot.style_columns, color=colDelta)

biasCol = whaleBias >= biasTh ? color.new(BUY, 0) : whaleBias <= -biasTh ? color.new(SELL, 0) : color.new(color.silver, 20)
plot(whaleBias, "Whale Bias", color=biasCol, linewidth=2)
plot(crowdFlow, "Crowd Flow (all volume)", color=color.new(color.silver, 55), linewidth=1)

plot(showDxy ? corr : na, "DXY Correlation ×100", color=color.new(ORNG, 35), linewidth=1)

hline(0, "Zero", color=color.new(color.gray, 60))
hline(40, "", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
hline(-40, "", color=color.new(color.gray, 80), linestyle=hline.style_dotted)

plotshape(showOI and oiOk, "OI State Strip", shape.square, location.top, color=oiCol, size=size.tiny)
plotshape(isAbsorb, "Absorption Bar", shape.diamond, location.bottom, color=color.new(PURP, 0), size=size.tiny)

bgcolor(showTint and distrib ? color.new(SELL, 88) : showTint and accum ? color.new(BUY, 88) : na)

// ╔═══════════════════════════════════════════════════════╗
// ║  SUMMARY TABLE                                         ║
// ╚═══════════════════════════════════════════════════════╝
f_pos(p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right

var table tbl = table.new(f_pos(tblPos), 2, 9, bgcolor=color.new(#0d0d12, 15), border_color=color.new(color.gray, 65), border_width=1, frame_color=color.new(color.gray, 45), frame_width=1)

if barstate.islast and showTbl
    whaleAgoTxt = na(lastWhaleBar) ? "—" : str.tostring(bar_index - lastWhaleBar) + " bars ago " + (lastWhaleDir > 0 ? "▲" : "▼")
    whaleAgoCol = na(lastWhaleBar) ? color.gray : lastWhaleDir > 0 ? BUY : SELL
    absAgoTxt   = na(lastAbsorbBar) ? "—" : str.tostring(bar_index - lastAbsorbBar) + " bars ago"
    dxyTxt  = dxyOk ? (dxyUp ? "Rising" : "Falling") + " · corr " + str.tostring(corr, "#") : "n/a"
    dxyC    = dxyOk ? (dxyUp ? SELL : BUY) : color.gray   // rising dollar = usual crypto headwind
    flowC   = crowdFlow >= splitTh ? BUY : crowdFlow <= -splitTh ? SELL : color.silver

    table.cell(tbl, 0, 0, "WHALE & MACRO v2", text_color=color.white, text_size=tblSize, text_halign=text.align_left, bgcolor=color.new(#1c1c28, 0))
    table.cell(tbl, 1, 0, useClosed ? "closed-bar " : "live ", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right, bgcolor=color.new(#1c1c28, 0))
    table.cell(tbl, 0, 1, " Verdict", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 1, verdict + " ", text_color=verdictC, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 2, " Whale Bias", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(math.round(whaleBias)) + " ", text_color=biasCol, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 3, " Crowd Flow", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 3, str.tostring(math.round(crowdFlow)) + " ", text_color=flowC, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 4, " Last Whale Print", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 4, whaleAgoTxt + " ", text_color=whaleAgoCol, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 5, " Last Absorption", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 5, absAgoTxt + " ", text_color=na(lastAbsorbBar) ? color.gray : PURP, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 6, " OI Read", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 6, oiTxt + " ", text_color=oiCol, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 7, " OI Δ bar / 24h", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 7, (na(oiDeltaPct) ? "—" : str.tostring(oiDeltaPct, "#.###") + "%") + " / " + (na(oi24hPct) ? "—" : str.tostring(oi24hPct, "#.#") + "%") + " ", text_color=oiCol, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 8, " DXY", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 8, dxyTxt + " ", text_color=dxyC, text_size=tblSize, text_halign=text.align_right)

// ╔═══════════════════════════════════════════════════════╗
// ║  ALERTS (closed-bar when the precision switch is ON)   ║
// ╚═══════════════════════════════════════════════════════╝
aOk = not useClosed or barstate.isconfirmed

alertcondition(aOk and cWhale and cDelta > 0, "Whale Buy Bar",  "Whale PRINT on the BUY side (top-percentile volume + one-sided delta)")
alertcondition(aOk and cWhale and cDelta < 0, "Whale Sell Bar", "Whale PRINT on the SELL side (top-percentile volume + one-sided delta)")
alertcondition(aOk and ta.crossover(cBias, biasTh),   "Whale Bias Flip Long",  "Whale flow bias crossed above the long threshold")
alertcondition(aOk and ta.crossunder(cBias, -biasTh), "Whale Bias Flip Short", "Whale flow bias crossed below the short threshold")
alertcondition(aOk and cAbsorb, "Absorption Bar", "Top-percentile volume inside a bottom-percentile range — iceberg absorption")
alertcondition(aOk and distrib and not distrib[1], "Distribution Split", "Whales selling into crowd buying — distribution signature")
alertcondition(aOk and accum and not accum[1],     "Accumulation Split", "Whales buying into crowd selling — accumulation signature")
alertcondition(aOk and cOiState == 1 and f_c(oiState[1]) != 1, "New Longs Opening",  "OI rising with price rising — new longs entering")
alertcondition(aOk and cOiState == 2 and f_c(oiState[1]) != 2, "New Shorts Opening", "OI rising with price falling — new shorts entering")
