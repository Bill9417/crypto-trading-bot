modeInput   = input.string(HISTORICAL, 'Mode', group=gI, options=[HISTORICAL, PRESENT], tooltip="Historical = keep all; Present = only most recent")
styleInput  = input.string(COLORED, 'Style', group=gI, options=[COLORED, MONOCHROME])
showTrendInput = input(false, 'Color Candles', group=gI)

showInternalsInput = input(true, 'Show Internal Structure', group=gI)
showInternalBullInput = input.string(ALL, 'Bullish', group=gI, inline='ibull', options=[ALL,BOS,CHOCH])
internalBullColorInput = input(GREEN, '', group=gI, inline='ibull')
showInternalBearInput = input.string(ALL, 'Bearish', group=gI, inline='ibear', options=[ALL,BOS,CHOCH])
internalBearColorInput = input(RED, '', group=gI, inline='ibear')
internalFilterConfluenceInput = input(false, 'Confluence Filter', group=gI)
internalStructureSize = input.string(TINY, 'Internal Label Size', group=gI, options=[TINY,SMALL,NORMAL])

showStructureInput = input(false, 'Show Swing Structure', group=gW)
showSwingBullInput = input.string(ALL, 'Bullish', group=gW, inline='bull', options=[ALL,BOS,CHOCH])
swingBullColorInput = input(GREEN, '', group=gW, inline='bull')
showSwingBearInput = input.string(ALL, 'Bearish', group=gW, inline='bear', options=[ALL,BOS,CHOCH])
swingBearColorInput = input(RED, '', group=gW, inline='bear')
swingStructureSize = input.string(SMALL, 'Swing Label Size', group=gW, options=[TINY,SMALL,NORMAL])
showSwingsInput = input(false, 'Show Swing Points', group=gW, inline='swings')
