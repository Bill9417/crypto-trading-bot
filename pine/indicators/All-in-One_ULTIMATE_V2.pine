showInternalOrderBlocksInput = input(false, 'Internal Order Blocks', group=gB, inline='iob')  // default OFF — visually replaced by ⑨ Reactive S/R Zones; turn back on anytime
internalOrderBlocksSizeInput = input.int(5, '', group=gB, minval=1, maxval=20, inline='iob')
showSwingOrderBlocksInput = input(false, 'Swing Order Blocks', group=gB, inline='ob')
swingOrderBlocksSizeInput = input.int(5, '', group=gB, minval=1, maxval=20, inline='ob')
orderBlockFilterInput = input.string('Atr', 'OB Filter', group=gB, options=[ATR, RANGE])
orderBlockMitigationInput = input.string(HIGHLOW, 'OB Mitigation', group=gB, options=[CLOSE,HIGHLOW])
internalBullishOrderBlockColor = input.color(color.new(#3179f5, 80), 'Internal Bullish OB', group=gB)
internalBearishOrderBlockColor = input.color(color.new(#f77c80, 80), 'Internal Bearish OB', group=gB)
swingBullishOrderBlockColor = input.color(color.new(#1848cc, 80), 'Bullish OB', group=gB)
swingBearishOrderBlockColor = input.color(color.new(#b22833, 80), 'Bearish OB', group=gB)

showEqualHighsLowsInput = input(true, 'Equal High/Low', group=gQ)
