zigzagColor = input.color(color.new(color.gray, 30), "ZigZag Color", group=gS, tooltip="Color of the zigzag swing line.")
show_msb_line = input.bool(false, "Show MSB Structure Lines", group=gS, tooltip="The horizontal green/red line at each structure break. OFF keeps the OB/BB blocks but hides the line.")
fib_factor  = input.float(0.33, "Breakout Confirm (Fib)", 0, 1, 0.01, group=gS)
text_size   = input.string(size.tiny, "Zone Label Size", [size.tiny, size.small, size.normal, size.large, size.huge], group=gS)
delete_boxes = input.bool(true, "Remove Broken Zones", group=gS)
bu_ob_color = input.color(color.new(color.green, 70), "Bullish OB", group=gS, inline="buob")
bu_ob_border_color = input.color(color.green, "", group=gS, inline="buob")
bu_ob_text_color = input.color(color.green, "", group=gS, inline="buob")
be_ob_color = input.color(color.new(color.red, 70), "Bearish OB", group=gS, inline="beob")
be_ob_border_color = input.color(color.red, "", group=gS, inline="beob")
be_ob_text_color = input.color(color.red, "", group=gS, inline="beob")
bu_bb_color = input.color(color.new(color.green, 70), "Bullish BB/MB", group=gS, inline="bubb")
bu_bb_border_color = input.color(color.green, "", group=gS, inline="bubb")
bu_bb_text_color = input.color(color.green, "", group=gS, inline="bubb")
be_bb_color = input.color(color.new(color.red, 70), "Bearish BB/MB", group=gS, inline="bebb")
be_bb_border_color = input.color(color.red, "", group=gS, inline="bebb")
be_bb_text_color = input.color(color.red, "", group=gS, inline="bebb")

// ════════════════════════════════════════════════════════════════════════════
//  SMC INPUTS (LuxAlgo) — groups ⑤–⑧, BOS/CHoCH text removed
// ════════════════════════════════════════════════════════════════════════════
BULLISH_LEG = 1
BEARISH_LEG = 0
