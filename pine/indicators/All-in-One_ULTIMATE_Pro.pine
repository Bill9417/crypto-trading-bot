be_ob_text_color = input.color(color.red, "", group=gS, inline="beob")
bu_bb_color = input.color(color.new(color.green, 70), "Bullish BB/MB", group=gS, inline="bubb")
bu_bb_border_color = input.color(color.green, "", group=gS, inline="bubb")
