// ════════════════════════════════════════════════════════════════════════════
//  DIVERGENCE RADAR — 背離雷達
//  Lower pane. Three questions, nothing else:
//
//    1. RIGHT NOW, is money leaning long or short?   → Whale Bias + OI Read
//    2. Is price making a new extreme that momentum refuses to confirm?
//    3. WHEN did that happen, and how many times?    → the panel
//
//  ── DETECTION IS NOT DISPLAY ──────────────────────────────────────────────
//  Three independent sources are ALWAYS measured for divergence — MACD, KD and
//  CVD — no matter what the pane draws. "Show which oscillator" only controls
//  the LINES. Six series in one pane is unreadable, and a pane you don't read
//  is worse than one indicator you do, so the default draws one oscillator and
//  the panel reports all three.
//
//  ── WHAT DIVERGENCE MEANS HERE (背離) ─────────────────────────────────────
//  Regular divergence only:
//    ▼ BEARISH — price prints a HIGHER high, the source prints a LOWER high.
//    ▲ BULLISH — price prints a LOWER low,  the source prints a HIGHER low.
//  All three are compared against the SAME price pivots, so agreement lands on
//  one bar. That is why there is ONE marker per direction per bar and its size
//  is how many sources agree — 1 faint, 2 solid, 3 large + label. Reading three
//  rows of coloured dots is work; reading one triangle that got bigger is not.
//  Marker colour is DIRECTION, never source: direction is what you need at a
//  glance, source is a detail the panel already carries.
//
//    MACD — momentum of trend. Slow, fewest signals, most weight.
//    KD   — momentum of position in range. Faster, noisier.
//    CVD  — cumulative buy/sell volume. Not momentum at all: it asks whether
//           the move was PAID FOR. A high with no CVD high had no real buying.
//
//  ── THE HONEST PART: THE MARKERS ARE LATE ON PURPOSE ──────────────────────
//  A pivot is not a pivot until `Pivot Length` bars have closed after it.
//  Confirming earlier would mean re-drawing markers as new bars arrive — a
//  perfect history that never existed live. Every marker appears exactly
//  `Pivot Length` bars after the pivot it refers to and never moves again. The
//  panel prints the PIVOT's own timestamp, so "when did it happen" is the
//  truth, and the bars-ago number is the lag you are actually living with.
//
//  Divergence is a warning about momentum, NOT an entry. Price can keep going
//  and print three on the way up. That is why they are COUNTED: one is noise,
//  a stack of them without a break is a condition.
//
//  ── OI READ ───────────────────────────────────────────────────────────────
//    OI ↑ + price ↑ = new LONGS opening      (green)
//    OI ↑ + price ↓ = new SHORTS opening     (red)
//    OI ↓ + price ↑ = shorts CLOSING/squeeze (teal)
//    OI ↓ + price ↓ = longs CLOSING/flush    (orange)
//  Averaged across Binance/Bybit/OKX using each venue's OWN Δ%, so different
//  contract units cannot distort it. OI can never say WHO opened — every long
//  has a short on the other side — which is why it is read beside the bias.
//
//  ── NOTHING MISSING IS FILLED WITH A ZERO ─────────────────────────────────
//  A dropped OI feed does not get smoothed in as 0%, and a closed dollar
//  market does not get counted as a flat-return day. Both would be asserting a
//  measurement that was never made, and enough of them drag any average toward
//  "nothing happened". The OI strip goes grey; the DXY row says "mkt shut".
// ════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Divergence Radar", overlay=false, format=format.price, precision=1,
     max_labels_count=500)

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  INPUTS — every one is read BELOW this block, never above it. Pine
// ║  resolves names top-down; an input under the function that reads it is
// ║  CE10272, visible only in the browser. pine/check_pine.py catches it here.
// ╚═══════════════════════════════════════════════════════════════════════════
gView = "① 版面 View"
oscView   = input.string("MACD", "Draw which oscillator", ["MACD", "KD", "Both", "None"], group=gView, tooltip="LINES only. MACD, KD and CVD are always measured for divergence regardless of this setting — the panel reports all three either way. Start with one line; add the second only when you want to compare them.")
showBias  = input.bool(true,  "Draw Whale Bias",  group=gView, inline="v1")
showOI    = input.bool(true,  "OI strip",         group=gView, inline="v1")
showDxyLn = input.bool(false, "Draw DXY correlation line", group=gView, tooltip="Off by default: the correlation is context you glance at, not something you watch tick by tick, and it costs a whole extra line in the pane. The panel always shows it as a number.")
showDelta = input.bool(false, "Draw raw delta columns", group=gView, tooltip="The per-bar buy/sell split the Whale Bias is built from. Off by default — it competes with the oscillator lines for the eye.")

gDiv = "② 背離 Divergence"
divLen    = input.int(5, "Pivot Length", minval=2, maxval=30, group=gDiv, tooltip="Bars required on BOTH sides of a pivot. Also the confirmation lag: markers appear this many bars after the pivot. Bigger = fewer, more meaningful pivots, later.")
useMacdD  = input.bool(true, "MACD", group=gDiv, inline="src")
useKdD    = input.bool(true, "KD",   group=gDiv, inline="src")
useCvdD   = input.bool(true, "CVD",  group=gDiv, inline="src", tooltip="Which sources are measured. Turning one off removes it from the markers, the counts and the panel.")
countLen  = input.int(200, "Count Window (bars)", minval=20, maxval=2000, group=gDiv, tooltip="How far back the panel counts. 200 bars ≈ 2 days on 15m.")
labelStrong = input.bool(true, "Label when 2+ sources agree", group=gDiv, tooltip="A small tag naming which sources fired. Only for 2+ — labelling every single divergence is what makes these panes unreadable.")

gMacd = "③ MACD ReLoaded"
macdSrc   = input.source(close, "Source", group=gMacd)
mav       = input.string("VAR", "Moving Average Type", ["SMA","EMA","WMA","DEMA","TMA","VAR","WWMA","ZLEMA","TSF","HULL","TILL"], group=gMacd, tooltip="Kivanc Ozbilgic's MACD ReLoaded: the same MACD structure with a swappable average. VAR (VIDYA) is the default — its smoothing constant scales with |CMO|, so it tracks hard in a trend and goes quiet in chop. All three legs (fast, slow, signal) use this same type, as in the original.")
macdFast  = input.int(12, "Fast", minval=2, group=gMacd, inline="m")
macdSlow  = input.int(26, "Slow", minval=3, group=gMacd, inline="m")
macdSig   = input.int(9,  "Signal", minval=1, group=gMacd, inline="m")
t3factor  = input.float(0.7, "TILLSON T3 Volume Factor", minval=0.0, maxval=1.0, step=0.1, group=gMacd)
showHist  = input.bool(false, "Draw MACD histogram", group=gMacd, tooltip="Four-state colouring: rising/falling above and below zero. Off by default so it does not compete with the lines — turn it on if you read the histogram rather than the crossover.")
normLen   = input.int(200, "Display Scaling Window", minval=50, maxval=2000, group=gMacd, tooltip="MACD is in PRICE units, so on this shared pane it is divided by its own recent maximum to fit −100…+100. Display only — divergences are detected on the RAW MACD, so scaling can never create or hide one.")

gKd = "④ KDJ"
kLen      = input.int(9, "Range Length (%K)", minval=1, group=gKd, tooltip="9 is canonical for this formula — the 2/3 · 1/3 recursion IS the Chinese KDJ, and 9 is what every Asian package draws. The script this came from used 14; set it back if you prefer that.")
kSmooth   = input.int(1, "%K extra smooth", minval=1, group=gKd, inline="s")
dSmooth   = input.int(1, "%D extra smooth", minval=1, group=gKd, inline="s")
jSmooth   = input.int(1, "J smooth", minval=1, group=gKd, inline="s", tooltip="1 = textbook KDJ. The source script defaulted these to 3 AND built J from the UNsmoothed K/D, so the J you saw did not match the K and D lines beside it. Here J is always built from the same K and D that are drawn, at any setting.")
kdDivSrc  = input.string("K", "Divergence uses", ["K","D","J"], group=gKd, tooltip="Which KDJ line is compared against price pivots. K is the usual choice; J overshoots by design and produces far more, far noisier divergences.")
showJ     = input.bool(true, "Draw J line", group=gKd)

gW = "⑤ Whale Bias"
ltfInput   = input.timeframe("1", "Intrabar Timeframe", group=gW, tooltip="Splits each chart bar into buy/sell volume — the raw material for both Whale Bias and CVD. '1' is most precise. TradingView limits intrabar history; older bars fall back to a close-position estimate automatically.")
whalePct   = input.int(90, "Whale Percentile", minval=70, maxval=99, group=gW, tooltip="A bar is a 'whale bar' at or above this percentile of volume. 90 = top 10%.")
pctLen     = input.int(200, "Percentile Lookback", minval=50, maxval=1000, group=gW)
biasLen    = input.int(96, "Bias Window (bars)", minval=20, maxval=500, group=gW, tooltip="96 bars = 1 day on 15m; use 48 on 30m.")
biasTh     = input.int(40, "Bias Threshold (±)", minval=10, maxval=90, group=gW)

gO = "⑥ Open Interest"
useBinance = input.bool(true, "Binance", inline="ven", group=gO)
useBybit   = input.bool(true, "Bybit",   inline="ven", group=gO)
useOkx     = input.bool(true, "OKX",     inline="ven", group=gO, tooltip="A venue that does not list this coin returns nothing and is skipped.")
oiSmoothLen= input.int(3, "OI Smoothing (EMA)", minval=1, maxval=20, group=gO, tooltip="Per-bar OI flips constantly on 15m. 1 = raw.")
oiOverride = input.symbol("", "OI Symbol Override", group=gO, tooltip="Empty = aggregated. Set a specific *_OI symbol to use only that feed.")

gD = "⑦ DXY"
dxySym     = input.symbol("TVC:DXY", "Dollar Index (blank = off)", group=gD, tooltip="Correlation of RETURNS. Bars where the dollar market was shut are SKIPPED, not counted as zero-return, so a weekend cannot drag the reading toward 'no relationship'.")
corrLen    = input.int(200, "Correlation Length (bars)", minval=30, maxval=1000, group=gD, tooltip="Counted in dollar-TRADING bars, not calendar bars. 200 ≈ 2 dollar days on 15m. Crypto/DXY correlation is unstable — context, not a rule.")
dxyTrendLen= input.int(50, "DXY Trend EMA", minval=10, maxval=500, group=gD)

gP = "⑧ Panel"
showTbl   = input.bool(true, "Show Panel", group=gP)
tblPos    = input.string("Top Right", "Position", ["Top Right","Top Left","Bottom Right","Bottom Left"], group=gP)
tblSize   = input.string(size.small, "Text Size", [size.tiny, size.small, size.normal], group=gP)
histN     = input.int(3, "Recent events listed", minval=1, maxval=6, group=gP)

// palette — deliberately small. Direction is red/green everywhere; the two
// oscillator lines are the only other hues, so nothing competes for meaning.
BUY  = #26a69a
SELL = #ef5350
AMBR = #ffb300
TEAL = #4dd0e1
ORNG = #ff9800
MCOL = #42a5f5
KCOL = #ab47bc

tfSec = math.max(60, timeframe.in_seconds(timeframe.period))

drawMacd = oscView == "MACD" or oscView == "Both"
drawKd   = oscView == "KD"   or oscView == "Both"

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  HELPERS
// ╚═══════════════════════════════════════════════════════════════════════════
// Intrabar signed volume: an up-closing minute counts as aggressive buying.
f_delta() =>
    close > open ? volume : close < open ? -volume : close >= nz(close[1], close) ? volume : -volume

f_oiDeltaPct(string tick) =>
    c = request.security(tick, timeframe.period, close, ignore_invalid_symbol=true)
    not na(c) and nz(c[1]) > 0 ? (c - c[1]) / c[1] * 100 : na

f_pos(string p) =>
    p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right

f_clamp(float v, float lim) =>
    math.max(-lim, math.min(lim, v))

// ── the MA library, written ONCE ───────────────────────────────────────────
// The original carried three near-identical copies of this (getMA / getMA1 /
// getMA2, ~200 lines) because each length needed its own globals. One function
// with a `simple int` length parameter does all three. The qualifier is
// load-bearing, not decoration: a length that reaches ta.sma() as `series` is a
// compile error, and that is exactly how it arrives if the parameter is left
// to be inferred.
//
// Every candidate is evaluated on EVERY bar and the choice is made afterwards.
// A ta.* call reached only on some bars keeps a stale internal window — safe
// here only because `mav` never changes mid-run, which is the kind of "safe
// because of something happening elsewhere" that stops being true the first
// time someone makes the type dynamic.
f_ma(simple string t, float s, simple int len) =>
    sma_  = ta.sma(s, len)
    ema_  = ta.ema(s, len)
    wma_  = ta.wma(s, len)
    dema_ = 2 * ema_ - ta.ema(ema_, len)
    tma_  = ta.sma(ta.sma(s, int(math.ceil(len / 2.0))), int(math.floor(len / 2.0)) + 1)

    // VAR / VIDYA — alpha scales with |CMO| over a fixed 9-bar momentum window
    // (9 is part of the original formula, not the MA length).
    vud  = s > s[1] ? s - s[1] : 0.0
    vdd  = s < s[1] ? s[1] - s : 0.0
    vUD  = math.sum(vud, 9)
    vDD  = math.sum(vdd, 9)
    vCMO = vUD + vDD != 0 ? (vUD - vDD) / (vUD + vDD) : 0.0
    vk   = 2.0 / (len + 1) * math.abs(vCMO)
    // Seeded with the source. The original seeded from 0, so the line crawled
    // up from zero over dozens of bars — a warm-up artefact that this script
    // would have read as a monster divergence at the left edge of the chart.
    var float var_ = na
    var_ := na(var_) ? s : vk * s + (1 - vk) * var_

    var float wwma_ = na
    wwa = 1.0 / len
    wwma_ := na(wwma_) ? s : wwa * s + (1 - wwa) * wwma_

    zlag   = int(len / 2)
    zlema_ = ta.ema(s + (s - s[zlag]), len)

    lr0  = ta.linreg(s, len, 0)
    lr1  = ta.linreg(s, len, 1)
    tsf_ = 2 * lr0 - lr1                       // == linreg + (linreg − linreg[1])

    hull_ = ta.wma(2 * ta.wma(s, int(math.max(1, math.round(len / 2.0)))) - ta.wma(s, len), int(math.max(1, math.round(math.sqrt(len)))))

    e1 = ta.ema(s, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    e4 = ta.ema(e3, len)
    e5 = ta.ema(e4, len)
    e6 = ta.ema(e5, len)
    a  = t3factor
    till_ = -a*a*a * e6 + (3*a*a + 3*a*a*a) * e5 + (-6*a*a - 3*a - 3*a*a*a) * e4 + (1 + 3*a + a*a*a + 3*a*a) * e3

    switch t
        "SMA"   => sma_
        "EMA"   => ema_
        "WMA"   => wma_
        "DEMA"  => dema_
        "TMA"   => tma_
        "VAR"   => var_
        "WWMA"  => wwma_
        "ZLEMA" => zlema_
        "TSF"   => tsf_
        "HULL"  => hull_
        "TILL"  => till_
        => ema_

f_srcTxt(bool m, bool k, bool c) =>
    string s = m ? "MACD" : ""
    s := k ? (s == "" ? "KD" : s + "+KD") : s
    s := c ? (s == "" ? "CVD" : s + "+CVD") : s
    s

// Divergence tracker. Pivots are computed OUTSIDE and handed in: ta.pivothigh
// needs a `simple int` length, and a length passed through a user function is
// inferred as `series` — a compile error, not a warning. `var` inside a
// function is instantiated per CALL SITE, so calling this three times keeps
// three independent memories, which is exactly what is wanted.
f_divTrack(float phVal, float plVal, float oscAtPivot) =>
    var float lastPH  = na
    var float lastPHo = na
    var float lastPL  = na
    var float lastPLo = na
    bool bear = false
    bool bull = false
    if not na(phVal) and not na(oscAtPivot)
        if not na(lastPH) and phVal > lastPH and oscAtPivot < lastPHo
            bear := true
        lastPH  := phVal
        lastPHo := oscAtPivot
    if not na(plVal) and not na(oscAtPivot)
        if not na(lastPL) and plVal < lastPL and oscAtPivot > lastPLo
            bull := true
        lastPL  := plVal
        lastPLo := oscAtPivot
    [bear, bull]

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ① OSCILLATORS
// ╚═══════════════════════════════════════════════════════════════════════════
// MACD ReLoaded — same structure as the classic, swappable average.
macdLine   = f_ma(mav, macdSrc, macdFast) - f_ma(mav, macdSrc, macdSlow)
macdSignal = f_ma(mav, macdLine, macdSig)
macdHist   = macdLine - macdSignal

// KDJ — the Chinese variant. RSV is the raw stochastic; K and D are recursive
// 2/3 · 1/3 smoothings of it, seeded at 50 so the first bars are neutral
// rather than pinned to an extreme.
//
// The source used 0.666 / 0.334. They sum to 1.000 so nothing drifts, but they
// are not 2/3 and 1/3, and the error compounds through a recursion that never
// forgets. Exact fractions cost nothing.
rsv = ta.stoch(close, high, low, kLen)
var float kRaw = na
var float dRaw = na
kRaw := (2.0 / 3.0) * nz(kRaw[1], 50) + (1.0 / 3.0) * nz(rsv, 50)
dRaw := (2.0 / 3.0) * nz(dRaw[1], 50) + (1.0 / 3.0) * nz(kRaw, 50)

// ta.sma(x, 1) is x, so length 1 is a genuine no-op — no conditional needed.
// J is built from the SAME k and d that get plotted. The source smoothed the
// plotted lines but computed J from the unsmoothed pair, so the J on screen
// was not 3K−2D of the K and D on screen.
k = ta.sma(kRaw, kSmooth)
d = ta.sma(dRaw, dSmooth)
j = ta.sma(3 * k - 2 * d, jSmooth)

kdDiv = kdDivSrc == "D" ? d : kdDivSrc == "J" ? j : k

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ② WHALE FLOW + CVD  (CVD is the third divergence source, so it comes
// ║     before the divergence block)
// ╚═══════════════════════════════════════════════════════════════════════════
deltaArr = request.security_lower_tf(syminfo.tickerid, ltfInput, f_delta())

// Beyond TradingView's intrabar history limit there is no minute data, so the
// buy share is ESTIMATED from where the bar closed inside its own range. It is
// only used where no measurement exists — and it means CVD divergences deep in
// history rest on an estimate, while recent ones rest on real intrabar volume.
float rawDelta = deltaArr.size() > 0 ? deltaArr.sum() : (high == low ? 0.0 : nz(volume) * (2 * (close - low) / (high - low) - 1))
float deltaPct = nz(volume) > 0 ? rawDelta / volume * 100 : 0.0

whaleThr = ta.percentile_nearest_rank(volume, pctLen, whalePct)
isWhale  = not na(whaleThr) and nz(volume) >= whaleThr

biasNum   = math.sum(isWhale ? rawDelta : 0.0, biasLen)
biasDen   = math.sum(isWhale ? math.abs(rawDelta) : 0.0, biasLen)
whaleBias = biasDen > 0 ? biasNum / biasDen * 100 : 0.0

var float cvd = 0.0
cvd += rawDelta

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ③ DIVERGENCE — one set of price pivots, three sources
// ╚═══════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, divLen, divLen)
pl = ta.pivotlow(low, divLen, divLen)

[macdBear, macdBull] = f_divTrack(ph, pl, macdLine[divLen])
[kdBear,   kdBull]   = f_divTrack(ph, pl, kdDiv[divLen])
[cvdBear,  cvdBull]  = f_divTrack(ph, pl, cvd[divLen])

mBear = useMacdD and macdBear
mBull = useMacdD and macdBull
kBear = useKdD   and kdBear
kBull = useKdD   and kdBull
cBear = useCvdD  and cvdBear
cBull = useCvdD  and cvdBull

int bearN = (mBear ? 1 : 0) + (kBear ? 1 : 0) + (cBear ? 1 : 0)
int bullN = (mBull ? 1 : 0) + (kBull ? 1 : 0) + (cBull ? 1 : 0)

// Consecutive same-direction divergences — the number that actually matters.
// One is noise; three stacked without the opposite firing is a condition. The
// run resets on the opposite signal, not on a timer, so it measures structure.
var int bearRun = 0
var int bullRun = 0
if bearN > 0
    bearRun += 1
    bullRun := 0
if bullN > 0
    bullRun += 1
    bearRun := 0

bearAny = math.sum(bearN > 0 ? 1 : 0, countLen)
bullAny = math.sum(bullN > 0 ? 1 : 0, countLen)
bearStr = math.sum(bearN >= 2 ? 1 : 0, countLen)
bullStr = math.sum(bullN >= 2 ? 1 : 0, countLen)

// ── event log: the PIVOT's own time, not the confirmation time ─────────────
var array<int>    evTime = array.new_int()
var array<int>    evBar  = array.new_int()
var array<string> evSrc  = array.new_string()
var array<int>    evDir  = array.new_int()      // +1 bullish, −1 bearish
var array<int>    evN    = array.new_int()      // how many sources agreed

f_push(int t, int b, string s, int dir, int n) =>
    array.push(evTime, t)
    array.push(evBar, b)
    array.push(evSrc, s)
    array.push(evDir, dir)
    array.push(evN, n)
    if array.size(evTime) > 40                  // bounded — a log, not a database
        array.shift(evTime)
        array.shift(evBar)
        array.shift(evSrc)
        array.shift(evDir)
        array.shift(evN)

pivotTime = time[divLen]
pivotBar  = bar_index - divLen
if bearN > 0
    f_push(pivotTime, pivotBar, f_srcTxt(mBear, kBear, cBear), -1, bearN)
if bullN > 0
    f_push(pivotTime, pivotBar, f_srcTxt(mBull, kBull, cBull), 1, bullN)

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ④ OPEN INTEREST
// ╚═══════════════════════════════════════════════════════════════════════════
baseCoin = syminfo.basecurrency
dBin = f_oiDeltaPct("BINANCE:" + baseCoin + "USDT.P_OI")
dByb = f_oiDeltaPct("BYBIT:"   + baseCoin + "USDT.P_OI")
dOkx = f_oiDeltaPct("OKX:"     + baseCoin + "USDT.P_OI")
dMan = f_oiDeltaPct(oiOverride == "" ? syminfo.tickerid + "_OI" : oiOverride)

float sumD = 0.0
int   cntD = 0
if useBinance and not na(dBin)
    sumD += dBin
    cntD += 1
if useBybit and not na(dByb)
    sumD += dByb
    cntD += 1
if useOkx and not na(dOkx)
    sumD += dOkx
    cntD += 1

float oiRawDelta = oiOverride != "" ? dMan : cntD > 0 ? sumD / cntD : dMan
string venueTxt  = oiOverride != "" ? "manual" : cntD > 0 ? str.tostring(cntD) + " ex" : "chart"
oiOk = not na(oiRawDelta)

// A missing reading is NOT smoothed as a zero. ta.ema(nz(x)) feeds 0 in
// whenever a venue drops out, asserting "open interest did not move" — a
// measurement this chart never made. This EMA advances only on bars that
// carried a reading and holds otherwise; the strip greys out so the gap shows.
var float oiEma = na
float alpha = 2.0 / (oiSmoothLen + 1)
if oiOk
    oiEma := na(oiEma) ? oiRawDelta : oiEma + alpha * (oiRawDelta - oiEma)

priceChgS = ta.ema(ta.change(close), oiSmoothLen)

// 1 longs opening · 2 shorts opening · 3 shorts closing · 4 longs closing
int oiState = not oiOk or na(oiEma) ? 0 : oiEma > 0 ? (priceChgS >= 0 ? 1 : 2) : oiEma < 0 ? (priceChgS >= 0 ? 3 : 4) : 0
color oiCol = oiState == 1 ? BUY : oiState == 2 ? SELL : oiState == 3 ? TEAL : oiState == 4 ? ORNG : color.new(color.gray, 55)
string oiTxt = oiState == 1 ? "Longs opening 開多" : oiState == 2 ? "Shorts opening 開空" : oiState == 3 ? "Shorts closing 空單回補" : oiState == 4 ? "Longs closing 多單平倉" : oiOk ? "Flat" : "no OI feed"

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ⑤ DXY — correlation over DOLLAR-TRADING bars only
// ╚═══════════════════════════════════════════════════════════════════════════
// gaps_on so a closed dollar market returns na instead of repeating its last
// close. Repeated closes read as "the dollar was flat" — a fabricated
// observation, and enough of them drive any correlation toward zero.
useDxy = dxySym != ""
dxyRaw = request.security(useDxy ? dxySym : syminfo.tickerid, timeframe.period, close, gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
bool dxyFresh = useDxy and not na(dxyRaw)

var float dxyHeld = na
if dxyFresh
    dxyHeld := dxyRaw
dxyOk = not na(dxyHeld)

// Pair each dollar return with the crypto return over the SAME span, so a
// two-day dollar move is never matched against one 15m candle. Pairs spanning
// a longer closure than this are dropped entirely.
dxyMaxGap = math.min(500, math.max(4, int(math.round(2.0 * 3600 / tfSec))))
var float prevDxy   = na
var float prevClose = na
var int   prevBar   = na
float rx = na
float ry = na
if dxyFresh
    gap = na(prevBar) ? 999999 : bar_index - prevBar
    if not na(prevDxy) and prevDxy > 0 and not na(prevClose) and prevClose > 0 and gap <= dxyMaxGap
        rx := close / prevClose - 1
        ry := dxyRaw / prevDxy - 1
    prevDxy   := dxyRaw
    prevClose := close
    prevBar   := bar_index

// Rolling Pearson over just the valid pairs. O(1) per bar, but the five sums
// are rebuilt exactly from the window once per window length: returns are ~1e-4
// and their squares ~1e-8, so add-one/subtract-one accumulators lose
// significance over a long history and can even drive the variance negative.
var array<float> cxA = array.new<float>()
var array<float> cyA = array.new<float>()
var float sX  = 0.0
var float sY  = 0.0
var float sXX = 0.0
var float sYY = 0.0
var float sXY = 0.0
var int   sinceExact = 0

if not na(rx) and not na(ry)
    array.push(cxA, rx)
    array.push(cyA, ry)
    sX  += rx
    sY  += ry
    sXX += rx * rx
    sYY += ry * ry
    sXY += rx * ry
    if array.size(cxA) > corrLen
        ox = array.shift(cxA)
        oy = array.shift(cyA)
        sX  -= ox
        sY  -= oy
        sXX -= ox * ox
        sYY -= oy * oy
        sXY -= ox * oy
    sinceExact += 1
    // `for 0 to size-1` counts DOWN when size is 0, so the guard is load-bearing
    if sinceExact >= corrLen and array.size(cxA) > 0
        sinceExact := 0
        sX  := 0.0
        sY  := 0.0
        sXX := 0.0
        sYY := 0.0
        sXY := 0.0
        for i = 0 to array.size(cxA) - 1
            vx = array.get(cxA, i)
            vy = array.get(cyA, i)
            sX  += vx
            sY  += vy
            sXX += vx * vx
            sYY += vy * vy
            sXY += vx * vy

int   nPair  = array.size(cxA)
minN         = math.max(30, corrLen / 4)
float varX   = nPair * sXX - sX * sX
float varY   = nPair * sYY - sY * sY
float denomC = varX > 0 and varY > 0 ? math.sqrt(varX * varY) : 0.0
float corr   = nPair >= minN and denomC > 0 ? (nPair * sXY - sX * sY) / denomC * 100 : na

dxyEma = ta.ema(dxyHeld, dxyTrendLen)
dxyUp  = dxyOk and not na(dxyEma) and dxyHeld > dxyEma
var int lastDxyBar = na
if dxyFresh
    lastDxyBar := bar_index
dxyAge = na(lastDxyBar) ? 999999 : bar_index - lastDxyBar
bool dxyStale = dxyAge > dxyMaxGap

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ⑥ PLOTS — normalised to −100…+100 so one pane can hold it
// ╚═══════════════════════════════════════════════════════════════════════════
// MACD lives in price units. Dividing by its own recent maximum is a DISPLAY
// transform only: divergence was already detected on the raw series above.
macdAbsMax = ta.highest(math.abs(macdLine), normLen)
macdPlot   = macdAbsMax > 0 ? macdLine / macdAbsMax * 100 : 0.0
sigPlot    = macdAbsMax > 0 ? macdSignal / macdAbsMax * 100 : 0.0

// KDJ is 0…100 → (v−50)×2 puts 50 on the zero line and maps 80/20 to ±60.
// J deliberately overshoots that range — that overshoot is the whole point of
// J — so the DRAWN value is clamped. Without it a single J spike to 140 sets
// the pane's scale and flattens every other line into a straight edge. The
// clamp is display only: divergence, the panel reading and the alerts all use
// the true J.
kPlot = (k - 50) * 2
dPlot = (d - 50) * 2
jPlot = f_clamp((j - 50) * 2, 125)

colDelta = isWhale ? (rawDelta >= 0 ? color.new(BUY, 25) : color.new(SELL, 25)) : (rawDelta >= 0 ? color.new(BUY, 88) : color.new(SELL, 88))
plot(showDelta ? deltaPct : na, "Delta % of volume", style=plot.style_columns, color=colDelta)

// Histogram first so the lines sit on top of it.
histPlot = macdAbsMax > 0 ? macdHist / macdAbsMax * 100 : 0.0
histCol  = macdHist >= 0 ? (macdHist > macdHist[1] ? color.new(BUY, 30) : color.new(BUY, 72)) : (macdHist > macdHist[1] ? color.new(SELL, 72) : color.new(SELL, 30))
plot(drawMacd and showHist ? histPlot : na, "MACD histogram", style=plot.style_columns, color=histCol)

plot(drawMacd ? macdPlot : na, "MACD (scaled)", color=color.new(MCOL, 0),  linewidth=2)
plot(drawMacd ? sigPlot  : na, "MACD signal",   color=color.new(MCOL, 60), linewidth=1)
plot(drawKd   ? kPlot    : na, "%K (scaled)",   color=color.new(KCOL, 0),  linewidth=1)
plot(drawKd   ? dPlot    : na, "%D (scaled)",   color=color.new(KCOL, 60), linewidth=1)
plot(drawKd and showJ ? jPlot : na, "J (scaled, clamped)", color=color.new(AMBR, 25), linewidth=1)

biasCol = whaleBias >= biasTh ? color.new(BUY, 0) : whaleBias <= -biasTh ? color.new(SELL, 0) : color.new(color.silver, 35)
plot(showBias ? whaleBias : na, "Whale Bias", color=biasCol, linewidth=3)

plot(showDxyLn and dxyOk ? corr : na, "DXY correlation ×100", color=color.new(ORNG, 25), linewidth=1)

hline(0, "Zero", color=color.new(color.gray, 55))
hline(60,  "KD 80 / bias +", color=color.new(color.gray, 82), linestyle=hline.style_dotted)
hline(-60, "KD 20 / bias −", color=color.new(color.gray, 82), linestyle=hline.style_dotted)

plotshape(showOI and oiState != 0, "OI strip", shape.square, location.top, color=oiCol, size=size.tiny)

// ONE marker per direction per bar. Size and opacity ARE the strength, so the
// pane never grows extra rows of dots as sources are added. Colour is
// direction only — which sources fired is in the label and the panel.
plotshape(bearN == 1, "▼ 1 source",  shape.triangledown, location.bottom, color.new(SELL, 62), size=size.tiny)
plotshape(bearN == 2, "▼ 2 sources", shape.triangledown, location.bottom, color.new(SELL, 20), size=size.small)
plotshape(bearN >= 3, "▼ 3 sources", shape.triangledown, location.bottom, color.new(SELL, 0),  size=size.normal)
plotshape(bullN == 1, "▲ 1 source",  shape.triangleup,   location.bottom, color.new(BUY, 62),  size=size.tiny)
plotshape(bullN == 2, "▲ 2 sources", shape.triangleup,   location.bottom, color.new(BUY, 20),  size=size.small)
plotshape(bullN >= 3, "▲ 3 sources", shape.triangleup,   location.bottom, color.new(BUY, 0),   size=size.normal)

if labelStrong and bearN >= 2
    label.new(bar_index, 0, "▼ " + f_srcTxt(mBear, kBear, cBear), color=color.new(SELL, 12), textcolor=color.white, style=label.style_label_down, size=size.tiny)
if labelStrong and bullN >= 2
    label.new(bar_index, 0, "▲ " + f_srcTxt(mBull, kBull, cBull), color=color.new(BUY, 12), textcolor=color.white, style=label.style_label_up, size=size.tiny)

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ⑦ PANEL
// ╚═══════════════════════════════════════════════════════════════════════════
// 8 fixed rows + up to 6 event rows + 2 count rows. Sized for the MAXIMUM the
// input allows, not the default: table.cell() past the declared row count is a
// runtime error, so a user sliding "Recent events listed" to 6 would crash a
// table built for 3.
var table tbl = table.new(f_pos(tblPos), 2, 16, bgcolor=color.new(#0d0d12, 12), border_color=color.new(color.gray, 65), border_width=1, frame_color=color.new(color.gray, 45), frame_width=1)

if barstate.islast and showTbl
    biasTxt = whaleBias >= biasTh ? "LONG lean" : whaleBias <= -biasTh ? "SHORT lean" : "Neutral"
    biasC   = whaleBias >= biasTh ? BUY : whaleBias <= -biasTh ? SELL : AMBR

    // "NOW" only claims a side when the two independent reads AGREE. They
    // measure different things — executed volume vs open positions — so
    // agreement is information and disagreement is also information. Calling
    // it anyway would be inventing a signal neither one gave. Resolved as a
    // STATE first, then rendered: deriving the colour by comparing the finished
    // string would break silently the day the wording changes.
    int biasSide = whaleBias >= biasTh ? 1 : whaleBias <= -biasTh ? -1 : 0
    int oiSide   = oiState == 1 ? 1 : oiState == 2 ? -1 : 0
    int nowState = biasSide != 0 and biasSide == oiSide ? biasSide * 2 : biasSide == 0 and oiSide == 0 ? 0 : biasSide != 0 and oiSide != 0 ? 9 : (biasSide + oiSide > 0 ? 1 : -1)
    string nowTxt = nowState == 2 ? "LONG 偏多 — 兩邊一致" : nowState == -2 ? "SHORT 偏空 — 兩邊一致" : nowState == 9 ? "分歧 — 兩邊相反" : nowState == 1 ? "微偏多" : nowState == -1 ? "微偏空" : "沒有方向"
    color nowC = nowState == 2 ? BUY : nowState == -2 ? SELL : AMBR

    runTxt = bearRun > 0 ? str.tostring(bearRun) + "× ▼ 連續看空" : bullRun > 0 ? str.tostring(bullRun) + "× ▲ 連續看多" : "—"
    runC   = bearRun > 0 ? SELL : bullRun > 0 ? BUY : color.gray

    corrTxt = na(corr) ? "…" : str.tostring(corr, "#")
    dxyTxt  = not dxyOk ? "off" : (dxyUp ? "Rising" : "Falling") + " · corr " + corrTxt + (dxyStale ? " (mkt shut)" : "")
    dxyC    = not dxyOk ? color.gray : dxyStale ? color.new(color.silver, 30) : dxyUp ? SELL : BUY   // rising dollar = usual crypto headwind (tendency, not a rule)

    table.cell(tbl, 0, 0, "背離雷達  DIVERGENCE RADAR", text_color=color.white, text_size=tblSize, text_halign=text.align_left, bgcolor=color.new(#1c1c28, 0))
    table.cell(tbl, 1, 0, "", bgcolor=color.new(#1c1c28, 0))

    table.cell(tbl, 0, 1, " NOW 現在", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 1, nowTxt + " ", text_color=nowC, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 2, " Whale Bias", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(math.round(whaleBias)) + " · " + biasTxt + " ", text_color=biasC, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 3, " OI Read", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 3, oiTxt + " ", text_color=oiCol, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 4, " OI Δ", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 4, (oiOk and not na(oiEma) ? str.tostring(oiEma, "#.###") + "% · " + venueTxt : "—") + " ", text_color=oiCol, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, 5, " DXY", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 5, dxyTxt + " ", text_color=dxyC, text_size=tblSize, text_halign=text.align_right)

    // J is the reason KDJ exists: it overshoots 0…100 and those excursions are
    // the signal. The pane clamps the LINE; this prints the real number.
    jTxt = str.tostring(j, "#") + (j > 100 ? " · 超買 overbought" : j < 0 ? " · 超賣 oversold" : k > d ? " · K>D" : " · K<D")
    jC   = j > 100 ? SELL : j < 0 ? BUY : k > d ? BUY : SELL
    table.cell(tbl, 0, 6, " KDJ  J", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, 6, jTxt + " ", text_color=jC, text_size=tblSize, text_halign=text.align_right)

    table.cell(tbl, 0, 7, " 連續背離 Run", text_color=color.white, text_size=tblSize, text_halign=text.align_left, bgcolor=color.new(#1c1c28, 0))
    table.cell(tbl, 1, 7, runTxt + " ", text_color=runC, text_size=tblSize, text_halign=text.align_right, bgcolor=color.new(#1c1c28, 0))

    // Recent events, newest first. Each row prints the PIVOT's own time plus
    // how many bars ago — the second number is the confirmation lag you are
    // living with, and it should never be a surprise.
    int n = array.size(evTime)
    for i = 0 to histN - 1
        int row = 8 + i
        if i < n
            int idx  = n - 1 - i
            int t    = array.get(evTime, idx)
            int b    = array.get(evBar, idx)
            string s = array.get(evSrc, idx)
            int dir  = array.get(evDir, idx)
            int cnt  = array.get(evN, idx)
            color c  = dir > 0 ? BUY : SELL
            table.cell(tbl, 0, row, " " + (dir > 0 ? "▲" : "▼") + " " + s + (cnt >= 2 ? " ●" : ""), text_color=c, text_size=tblSize, text_halign=text.align_left)
            table.cell(tbl, 1, row, str.format_time(t, "MM-dd HH:mm", syminfo.timezone) + " · " + str.tostring(bar_index - b) + " bars ago ", text_color=color.silver, text_size=tblSize, text_halign=text.align_right)
        else
            table.cell(tbl, 0, row, " —", text_color=color.gray, text_size=tblSize, text_halign=text.align_left)
            table.cell(tbl, 1, row, " ", text_color=color.gray, text_size=tblSize, text_halign=text.align_right)

    int r1 = 8 + histN
    table.cell(tbl, 0, r1, " 近 " + str.tostring(countLen) + " 根", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, r1, "▼" + str.tostring(bearAny) + "  ▲" + str.tostring(bullAny) + " ", text_color=color.silver, text_size=tblSize, text_halign=text.align_right)
    table.cell(tbl, 0, r1 + 1, " 其中 2+ 同時", text_color=color.silver, text_size=tblSize, text_halign=text.align_left)
    table.cell(tbl, 1, r1 + 1, "▼" + str.tostring(bearStr) + "  ▲" + str.tostring(bullStr) + " ", text_color=bearStr > bullStr ? SELL : bullStr > bearStr ? BUY : color.silver, text_size=tblSize, text_halign=text.align_right)

// ╔═══════════════════════════════════════════════════════════════════════════
// ║  ⑧ ALERTS
// ╚═══════════════════════════════════════════════════════════════════════════
alertcondition(bearN >= 1, "Bearish Divergence (any)",  "價格創新高但動能沒有跟上 — 出現看空背離")
alertcondition(bullN >= 1, "Bullish Divergence (any)",  "價格創新低但動能沒有跟上 — 出現看多背離")
alertcondition(bearN >= 2, "Bearish Divergence 2+ agree", "2 個以上來源同時出現看空背離")
alertcondition(bullN >= 2, "Bullish Divergence 2+ agree", "2 個以上來源同時出現看多背離")
alertcondition(bearN >= 3, "Bearish Divergence ALL 3",  "MACD + KD + CVD 三個同時看空背離")
alertcondition(bullN >= 3, "Bullish Divergence ALL 3",  "MACD + KD + CVD 三個同時看多背離")
alertcondition(ta.crossover(whaleBias, biasTh),   "Whale Bias Flip Long",  "大單流向轉多")
alertcondition(ta.crossunder(whaleBias, -biasTh), "Whale Bias Flip Short", "大單流向轉空")
alertcondition(oiState == 1 and oiState[1] != 1, "New Longs Opening",  "未平倉上升 + 價格上升 — 新多單進場")
alertcondition(oiState == 2 and oiState[1] != 2, "New Shorts Opening", "未平倉上升 + 價格下跌 — 新空單進場")
// The KDJ source computed `Buy = crossover(J,0)` and `Sell = crossunder(J,100)`
// and then never plotted or alerted on either — dead code in the original.
// They are the J extremes coming back inside the band, so they are wired up.
alertcondition(ta.crossover(j, 0),    "J back above 0",   "J 從超賣區翻上 0 — 極端賣壓收手")
alertcondition(ta.crossunder(j, 100), "J back below 100", "J 從超買區翻下 100 — 極端買盤收手")
alertcondition(ta.crossover(k, d),    "KDJ golden cross", "K 向上穿越 D — KD 黃金交叉")
alertcondition(ta.crossunder(k, d),   "KDJ death cross",  "K 向下穿越 D — KD 死亡交叉")
alertcondition(ta.crossover(macdLine, macdSignal),  "MACD cross up",   "MACD 向上穿越訊號線")
alertcondition(ta.crossunder(macdLine, macdSignal), "MACD cross down", "MACD 向下穿越訊號線")
