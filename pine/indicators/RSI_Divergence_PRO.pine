// ════════════════════════════════════════════════════════════════════════════
//  RSI DIVERGENCE PRO — 相對強弱背離（精準版）
//
//  TradingView's built-in RSI divergence, with the four holes closed that
//  Divergence_Radar_PRO already closed for MACD/KD/Fisher/CVD — and with the
//  SAME numbers the scanner uses, so the chart and the alerts cannot disagree.
//
//  ── WHAT THE BUILT-IN LEAVES OPEN ─────────────────────────────────────────
//  The stock rule is the textbook definition and nothing else:
//      bull = price lower-low AND rsi higher-low
//
//  1. NO NOISE FLOOR ON THE OSCILLATOR. An RSI higher-low of 0.01 points
//     satisfies the definition exactly as well as one of 12 points. This is
//     the biggest leak and the built-in has no control for it at all — it
//     filters the range between pivots (5…60 bars) and nothing else.
//     PRO requires the gap to clear `Min Momentum Gap`, expressed as a
//     FRACTION OF RSI's OWN RECENT RANGE rather than in RSI points, so the
//     same setting means the same thing on a quiet major and a violent alt.
//
//  2. NO SWING PROMINENCE. `ta.pivotlow(rsi, 5, 5)` calls any local dip a
//     pivot, including one inside a flat drift. PRO requires the PRICE pivot
//     to stand out from its neighbourhood by `Min Swing Size`, measured in ATR
//     AT THE PIVOT BAR — a swing that is not a swing cannot start a divergence.
//
//  3. DIVERGENCE ANYWHERE IN THE RANGE. A bullish divergence with RSI at 55 is
//     not exhaustion; it is noise wearing the shape. PRO can require RSI to
//     have been in its oversold/overbought zone AT THE PIVOT.
//
//  4. ONE PRIOR PIVOT ONLY. `ta.valuewhen(plFound, ..., 1)` compares against
//     the single previous pivot, whatever it happened to be.
//
//  ── WHAT IS *NOT* CLAIMED ─────────────────────────────────────────────────
//  Stricter is not the same as profitable. These filters make the signal rarer
//  and better-defined; they have NOT been shown to make money, on this chart
//  or anywhere else in this project. This repo has measured 48 high-win-rate
//  setups and found 46 of them losing. Treat a label as "this shape exists",
//  never as an entry.
//
//  ── WHY RSI AT ALL, WHEN FOUR SOURCES ALREADY EXIST ───────────────────────
//  Measured before it was added, on 25,454 bars across 22 crypto perps, as
//  Jaccard overlap of bullish-divergence bars:
//        KD  vs FISH  0.625   ← both ALREADY in the scanner
//        KD  vs RSI   0.340
//        MACD vs RSI  0.339
//        FISH vs RSI  0.277
//        CVD vs RSI   0.171
//  RSI is less redundant with the existing set than two members of that set
//  are with each other. That is the bar A/D failed when it was rejected from
//  the scanner's confluence (it is algebraically identical to CVD), and it is
//  a statement about INDEPENDENCE only — not about whether RSI predicts.
//
//  Mirrors app/strategy4.py: rsi_series() + bullish_divergence(). The defaults
//  below are pinned to that file by a parity test, so drift fails the suite.
// ════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("RSI Divergence PRO", shorttitle="RSI DIV PRO", overlay=false,
          format=format.price, precision=2, max_labels_count=200)

// ── RSI ─────────────────────────────────────────────────────────────────────
gRsi = "RSI"
rsiLen    = input.int(14, "RSI Length", minval=1, group=gRsi)
rsiSrc    = input.source(close, "Source", group=gRsi)

// ta.rma IS Wilder smoothing — (prev·(n−1) + new)/n — not an EMA. Swapping in
// ta.ema tracks closely enough to look right and differs by 2-4 points at the
// turns, which is exactly where a divergence is decided.
chg  = ta.change(rsiSrc)
up   = ta.rma(math.max(chg, 0), rsiLen)
down = ta.rma(-math.min(chg, 0), rsiLen)
rsi  = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

// ── divergence filters (mirror of strategy4.py) ────────────────────────────
gDiv = "Divergence"
divLen    = input.int(5,  "Pivot Lookback (each side)", minval=1, group=gDiv,
     tooltip="A pivot needs this many bars EITHER side, so it is only confirmed this many bars later. Nothing here can be acted on at the pivot bar itself.")
rangeLo   = input.int(5,  "Min bars between pivots", minval=1, group=gDiv)
rangeHi   = input.int(60, "Max bars between pivots", minval=2, group=gDiv,
     tooltip="Two lows 400 bars apart are not one swing structure; comparing them is arithmetic, not analysis.")
minOscGap = input.float(0.05, "Min Momentum Gap (× RSI range)", minval=0.0, maxval=1.0, step=0.01, group=gDiv,
     tooltip="How far RSI must have diverged, as a fraction of its own recent range. The built-in has no equivalent control — an 0.01-point higher low counts there exactly as much as a 12-point one.")
normLen   = input.int(200, "RSI range window", minval=20, group=gDiv)
minSwing  = input.float(0.8, "Min Swing Size (ATR at pivot)", minval=0.0, step=0.1, group=gDiv,
     tooltip="The PRICE pivot must stand out from its neighbourhood by this much ATR, measured at the pivot bar. A dip inside a flat drift is not a swing.")
useZone   = input.bool(false, "Require RSI extreme at the pivot", group=gDiv)
osLevel   = input.int(30, "Oversold", minval=1, maxval=50, group=gDiv)
obLevel   = input.int(70, "Overbought", minval=50, maxval=99, group=gDiv)

atrLen = input.int(14, "ATR Length", minval=1, group=gDiv)
atr    = ta.atr(atrLen)

// RSI's own range over `normLen`, so one gap setting means the same thing on a
// quiet major and a violent alt.
rsiRng = ta.highest(rsi, normLen) - ta.lowest(rsi, normLen)

ph = ta.pivothigh(high, divLen, divLen)
pl = ta.pivotlow(low,  divLen, divLen)

// Values AT the pivot bar — divLen bars back, which is why this is confirmed
// late rather than repainting.
rsiPv = rsi[divLen]
atrPv = atr[divLen]
hiPv  = high[divLen]
loPv  = low[divLen]

// Swing prominence at the pivot bar.
legUp = hiPv - math.min(ta.lowest(low, divLen * 2 + 1)[0], loPv)
legDn = math.max(ta.highest(high, divLen * 2 + 1)[0], hiPv) - loPv
legOkH = atrPv > 0 and legUp >= minSwing * atrPv
legOkL = atrPv > 0 and legDn >= minSwing * atrPv

var float prevLowPrice = na
var float prevLowRsi   = na
var int   prevLowBar   = na
var float prevHiPrice  = na
var float prevHiRsi    = na
var int   prevHiBar    = na

bullDiv = false
bearDiv = false

if not na(pl)
    gap = na(prevLowBar) ? na : bar_index - divLen - prevLowBar
    zoneOk = not useZone or prevLowRsi <= osLevel or rsiPv <= osLevel
    if not na(prevLowBar) and gap >= rangeLo and gap <= rangeHi and legOkL and zoneOk
        priceLL = loPv < prevLowPrice
        rsiHL   = rsiPv > prevLowRsi
        bigEnough = rsiRng > 0 and (rsiPv - prevLowRsi) >= minOscGap * rsiRng
        bullDiv := priceLL and rsiHL and bigEnough
    prevLowPrice := loPv
    prevLowRsi   := rsiPv
    prevLowBar   := bar_index - divLen

if not na(ph)
    gapH = na(prevHiBar) ? na : bar_index - divLen - prevHiBar
    zoneOkH = not useZone or prevHiRsi >= obLevel or rsiPv >= obLevel
    if not na(prevHiBar) and gapH >= rangeLo and gapH <= rangeHi and legOkH and zoneOkH
        priceHH = hiPv > prevHiPrice
        rsiLH   = rsiPv < prevHiRsi
        bigEnoughH = rsiRng > 0 and (prevHiRsi - rsiPv) >= minOscGap * rsiRng
        bearDiv := priceHH and rsiLH and bigEnoughH
    prevHiPrice := hiPv
    prevHiRsi   := rsiPv
    prevHiBar   := bar_index - divLen

// ── plot ────────────────────────────────────────────────────────────────────
plot(rsi, "RSI", color=#7E57C2, linewidth=2)
hline(obLevel, "Overbought", color=color.new(#787B86, 40))
hline(50,      "Middle",     color=color.new(#787B86, 70))
hline(osLevel, "Oversold",   color=color.new(#787B86, 40))

plotshape(bullDiv ? rsiPv : na, title="Bullish Divergence", offset=-divLen,
          location=location.absolute, style=shape.labelup, text="Bull",
          color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(bearDiv ? rsiPv : na, title="Bearish Divergence", offset=-divLen,
          location=location.absolute, style=shape.labeldown, text="Bear",
          color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// The alert says WHEN it was confirmed and WHERE the pivot was, because a
// label drawn `divLen` bars back reads as though it fired then. It did not.
alertcondition(bullDiv, "RSI Bullish Divergence (confirmed)",
     "RSI 多頭背離已確認 — 樞紐在 {{interval}} 的 5 根之前，現在才成立。這是形態，不是進場訊號。")
alertcondition(bearDiv, "RSI Bearish Divergence (confirmed)",
     "RSI 空頭背離已確認 — 樞紐在 {{interval}} 的 5 根之前，現在才成立。這是形態，不是進場訊號。")
