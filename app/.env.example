TELEGRAM_BOT_TOKEN=replace_with_your_real_bot_token
TELEGRAM_CHAT_ID=replace_with_your_real_chat_id
FLASK_SECRET_KEY=replace_with_a_long_random_secret
FLASK_HOST=127.0.0.1
FLASK_PORT=4000
FLASK_DEBUG=false
FLASK_SESSION_COOKIE_SECURE=false
FLASK_PREFERRED_URL_SCHEME=http

# ── Binance live trading (all OPTIONAL — leave LIVE_TRADING=false for dry-run) ──
LIVE_TRADING=false
USE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Which strategy the LIVE bot trades (backtest registry key). default=S1 Wolf
# Confluence (original), trend_breakout=S2, trend_trailing=S3, adaptive_trend=S4.
# Keep "default" unless you deliberately switch (changing it needs a bot restart;
# S3/S4 use a trailing stop). Best set from the admin Account page.
LIVE_STRATEGY=default
LEVERAGE=3
MARGIN_MODE=isolated
FIXED_MARGIN_USDT=50
MAX_MARGIN_USDT=200
# Max positions committed at once (resting brackets + filled). Caps correlated
# exposure when many alts qualify on the same candle. 0 = unlimited (risky).
MAX_CONCURRENT_POSITIONS=5
PLACE_BRACKET_ORDERS=true
# Resting-limit model: book the LIMIT entry + SL/TP bracket the moment a setup is
# queued, so the exchange fills it the instant price touches (no missed entries).
USE_RESTING_ORDERS=true
# Post-Only (maker-only) entry — guarantees the lower maker fee (GTX).
USE_POST_ONLY_ENTRY=true
# Partial take-profit (matches the dashboard): close 50% at TP1, 50% at TP2.
LIVE_PARTIAL_TP=true
# Used only when LIVE_PARTIAL_TP=false: single full-close target, tp2 (2R) or tp1 (1R).
LIVE_TP_TARGET=tp2

# ── Strategy 2 LIVE execution (the 15m TV.pine scanner) — OFF by default ──────
# false = the S2 scanner stays alert-only (Telegram + /strategy2 page, no orders).
# true  = a NEW high-conviction S2 signal places a real bracketed order via the
#         shared executor. Run ONE engine at a time: S2 live auto-skips every order
#         while the S1 bot (bot.lock) is running — stop S1 first. The global
#         LIVE_TRADING gate above still applies (false ⇒ dry-run logged, not sent).
STRATEGY2_LIVE=false
# "Best plan" conviction floor: a LONG needs score ≥ this, a SHORT needs ≤ (100−this).
# 85 ⇒ long ≥85 / short ≤15 — stricter than the 70/30 alert threshold. No BTC filter.
STRATEGY2_LIVE_MIN_SCORE=85
# Conviction → size (executor.position_scale): 5 = 1.0× the FIXED_MARGIN_USDT base,
# 6 = 1.5×. Keep 5 on a ~25 USDT account (1.5 USDT margin → 6 USDT notional at 4×).
STRATEGY2_LIVE_LIGHTS=5
# Only the top-N most-liquid USDT perps (by 24h volume) may place a live S2 order.
STRATEGY2_LIVE_TOP_N=150
