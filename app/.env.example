# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace_with_your_real_bot_token
TELEGRAM_CHAT_ID=replace_with_your_real_chat_id
# Optional second bot for automatic messages (fills, halts). Superseded by the
# topics group below whenever that is configured.
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=
# Topics group — one bot, one supergroup (Topics enabled), each feature its own
# topic thread. Create topics in Telegram (or let the bot createForumTopic) and
# paste the message_thread_id numbers here. Any empty thread falls back to the
# Alerts thread. The command bot (/winrate /positions /signals /alerts /report
# /tw /liq /help) answers in whichever topic you type in.
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_SIGNALS_THREAD_ID=      # 📊 S2 signal digests + HC alerts with Entry/SL/TP
TELEGRAM_ALERTS_THREAD_ID=       # 🔔 price alerts + everything without its own topic
TELEGRAM_EVENTS_THREAD_ID=       # 🌍 big-event radar (Fed/war/regulation/hack/whale)
TELEGRAM_TECH_THREAD_ID=         # 💻 6-hourly tech/AI news digest
TELEGRAM_REPORT_THREAD_ID=       # 📈 one morning account+market report per day
TELEGRAM_TWSTOCKS_THREAD_ID=     # 🇹🇼 台股 daily TW50 scan after the 13:30 close
TELEGRAM_LIQ_THREAD_ID=          # 💥 BTC/ETH liquidation-cascade alerts + 🧲 map

# ── Flask web dashboard ─────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace_with_a_long_random_secret
FLASK_HOST=127.0.0.1
FLASK_PORT=4000
FLASK_DEBUG=false
FLASK_SESSION_COOKIE_SECURE=false
FLASK_PREFERRED_URL_SCHEME=http

# ── Binance live trading (S1 bot + optional S2) ─────────────────────────────
# Leave LIVE_TRADING=false for dry-run: orders are logged, nothing is sent.
LIVE_TRADING=false
USE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_STRATEGY=default
LEVERAGE=3
MARGIN_MODE=isolated
FIXED_MARGIN_USDT=50
MAX_MARGIN_USDT=200
# Max positions committed at once (resting brackets + filled). 0 = unlimited (risky).
MAX_CONCURRENT_POSITIONS=5
PLACE_BRACKET_ORDERS=true
# Resting-limit model: book the LIMIT entry + SL/TP bracket the moment a setup
# is queued, so the exchange fills the instant price touches.
USE_RESTING_ORDERS=true
# Post-Only (maker-only) entry — guarantees the lower maker fee (GTX).
USE_POST_ONLY_ENTRY=true
# Partial take-profit: close 50% at TP1, 50% at TP2 (needs order sizes above the
# exchange minimum — turn off on tiny accounts).
LIVE_PARTIAL_TP=true
# Used only when LIVE_PARTIAL_TP=false: single full-close target, tp2 (2R) or tp1 (1R).
LIVE_TP_TARGET=tp2
LIVE_TRAIL_TO_BREAKEVEN=true

# ── Strategy 2 — 15m TV.pine confluence scanner ─────────────────────────────
# false = alert-only (Telegram + /strategy2 page). true = a NEW high-conviction
# S2 signal places a real bracketed order via the shared executor. Run ONE
# Binance engine at a time (S2 live auto-skips while the S1 bot holds bot.lock).
STRATEGY2_LIVE=false
STRATEGY2_LIVE_MIN_SCORE=85
STRATEGY2_LIVE_LIGHTS=5
STRATEGY2_LIVE_TOP_N=150
# Send a Telegram alert (with the full Entry/SL/TP plan) for every
# high-conviction fired signal, on top of the 30-min digests.
STRATEGY2_HC_ALERT=false
# Rows per side in the 30-min digest (the rest is summarised as "+N more").
STRATEGY2_DIGEST_MAX_ROWS=12
# Candle cache: re-fetch a symbol only when a new 15m bucket starts; between
# buckets the forming candle is refreshed from the bulk ticker (~3× fewer
# API calls, sweeps drop from ~170s to seconds). false = old fetch-everything.
STRATEGY2_OHLCV_CACHE=true

# ── Strategy 3 — Vegas flag-flip → BYBIT orders ─────────────────────────────
# Runs on the Bybit account below. Signals read BYBIT candles by default
# (data follows execution — thin symbols print different candles per venue).
STRATEGY3_LIVE=false
STRATEGY3_SYMBOLS=XAUT
STRATEGY3_MARGIN_USDT=16
STRATEGY3_LEVERAGE=50
STRATEGY3_EMERGENCY_SL_PCT=0.015
STRATEGY3_FEED=bybit
# Per-symbol overrides (XAUT = gold, trends slowly, runs the 30m chart):
STRATEGY3_XAUT_TIMEFRAME=30m
STRATEGY3_XAUT_MARGIN_USDT=40
# Bybit API key (Contract Trade + Position permissions ONLY — never withdrawal).
# Until these are filled AND LIVE_TRADING=true, S3 is dry-run (alerts, no orders).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Topic-service tunables (all optional) ───────────────────────────────────
# 💥 liquidation-cascade alert thresholds (USD per 10-min window):
LIQ_ALERT_BTC_USD=2000000
LIQ_ALERT_ETH_USD=1500000
# 💻 tech digest cadence / size:
TECH_DIGEST_SEC=21600
TECH_DIGEST_MAX=12
# 📈 daily report send hour (local time):
DAILY_REPORT_HOUR=8
# 🇹🇼 台股盤中 alert thresholds (percent):
TW_MOVER_PCT=3.5
TW_TAIEX_ALERT_PCT=1.5
# 🛑 S3 daily circuit breaker — halt NEW entries after this many losing
# closes / this deep a net loss in 24h (real Bybit closed-P&L). 0 = off.
# /resume clears the halt, /halt trips it manually (both admin-only).
STRATEGY3_MAX_DAILY_STOPS=2
STRATEGY3_MAX_DAILY_LOSS_USDT=45
# 🧹 automatic daily /clean of bot messages older than 24h (before they age
# past Telegram's 48h undeletable wall):
TG_AUTO_CLEAN=true
TG_AUTO_CLEAN_HOUR=4
# 📐 ETH 14d-momentum paper forward-test flip alerts:
ETH_MOM_ALERTS=true
# 💾 second copy of the daily state backup OFF this disk (default: iCloud
# Drive, synced by macOS automatically). Empty = local backups only.
#BACKUP_OFFSITE_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/WolfScannerBackups
