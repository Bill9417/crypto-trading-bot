# ─────────────────────────────────────────────────────────────────────────────
# SECRETS / CREDENTIALS — NEVER COMMIT. Real Binance keys + Telegram token live
# in app/.env. The .env.example template (placeholders only) IS committed.
# ─────────────────────────────────────────────────────────────────────────────
.env
*.env
# `*.env` only matches names ENDING in .env — a dated backup like
# app/.env.bak.20260802 slips through and would commit every secret.
.env.bak*
*.env.bak*
*.env.*
!.env.example
!app/.env.example

# TLS private keys (e.g. Tailscale Funnel cert key) — the .crt is public and
# fine to commit, the .key is not. One leaked into history once; don't repeat it.
*.key

# ── Flask instance: user logins (users.db) + signal DBs + session secrets ──
instance/
*.db
*.db.*
*.sqlite
*.sqlite3

# ── Runtime logs ──
logs/
*.log
*.out

# ── Runtime state / locks ──
*.lock
bot.lock
circuit_state.json
bot_strategy.json
paper_active.json
paper_state_*.json
